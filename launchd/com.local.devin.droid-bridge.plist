<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.local.devin.droid-bridge</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/bun</string>
        <string>/Users/yo_macbook/Documents/dev/devin-bridge/src/droid-bridge.ts</string>
    </array>
    <!-- No WorkingDirectory (launchd cannot chdir into ~/Documents; TCC blocks
         it) and no ProcessType (Background wedges the job in xpcproxy). Both
         leave the service spinning without ever exec'ing bun. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>5</integer>
    <key>StandardOutPath</key>
    <string>/tmp/devin-droid-bridge.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/devin-droid-bridge.log</string>
</dict>
</plist>
